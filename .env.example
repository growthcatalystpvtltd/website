# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthcatalyst?schema=public"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin seed credentials
ADMIN_EMAIL="admin@growthcatalyst.com.np"
ADMIN_PASSWORD="change-me-in-production"

# Company branding (NEXT_PUBLIC_ = exposed to browser)
NEXT_PUBLIC_COMPANY_NAME="Growth Catalyst"
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Growth Catalyst Pvt. Ltd."
NEXT_PUBLIC_COMPANY_TAGLINE="Accelerate · Enhance · Grow"
NEXT_PUBLIC_COMPANY_PHONE="+977 9851425426"
NEXT_PUBLIC_COMPANY_EMAIL="info@growthcatalyst.com.np"
NEXT_PUBLIC_COMPANY_ADDRESS="Shital Height, Mahalaxmi, Lalitpur, Nepal"
NEXT_PUBLIC_COMPANY_WEBSITE="https://growthcatalyst.com.np"
NEXT_PUBLIC_LOGO_URL="/logo.svg"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/growthcatalyst"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/growthcatalyst"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/growthcatalyst"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/growthcatalyst"

# Google Analytics 4 — Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# SMTP (server-side only)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@growthcatalyst.com.np"
SMTP_PASSWORD="your-app-password-here"
SMTP_FROM="Growth Catalyst <info@growthcatalyst.com.np>"
CONTACT_NOTIFY_EMAIL="info@growthcatalyst.com.np"
